{
  "name": "potenfyr-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Unified vanity docs hub for all public PotenFYR-Studios repositories, served on docs.potenfyr.in",
  "scripts": {
    "sync": "bun run scripts/gen-meta.ts",
    "build:content": "bun run scripts/build-content.ts",
    "dev": "vite",
    "build": "bun run sync && bun run build:content && vite build",
    "build:offline": "bun run build:content && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.15",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^20.14.5",
    "playwright": "1.49.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
